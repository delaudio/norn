FROM rust:1.94-bookworm AS build

WORKDIR /build/src-tauri
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./
COPY src-tauri/src ./src
COPY src-tauri/build.rs ./build.rs
COPY src/lib/defaultReviewPrompt.md /build/src/lib/defaultReviewPrompt.md
RUN cargo build --locked --release --no-default-features --bin norn --bin lachesi

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 norn \
    && useradd --uid 10001 --gid norn --create-home --home-dir /var/lib/norn norn

COPY --from=build /build/src-tauri/target/release/norn /usr/local/bin/norn
COPY --from=build /build/src-tauri/target/release/lachesi /usr/local/bin/lachesi

COPY integrations/agent-skills /usr/local/share/norn/agent-skills

USER norn
ENV NORN_SERVICE_DATA_DIR=/var/lib/norn
ENV NORN_SERVICE_BIND_ADDR=0.0.0.0:8080
VOLUME ["/var/lib/norn"]
EXPOSE 8080

ENTRYPOINT ["norn"]
CMD ["service", "run"]
