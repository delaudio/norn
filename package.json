{
  "name": "norn",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "description": "Local-first pull request review workspace with OpenTUI and a Rust engine",
  "scripts": {
    "version:verify": "node scripts/version-verify.mjs",
    "dev": "node scripts/dev-opentui.mjs",
    "build": "pnpm run browser-diff:build && pnpm run ui:build && pnpm run core:build",
    "browser-diff:build": "vite build --config vite.browser-diff.config.ts",
    "preview": "pnpm run dev",
    "web:dev": "pnpm --filter @norn/web dev",
    "web:build": "pnpm --filter @norn/web build",
    "web:preview": "pnpm --filter @norn/web preview",
    "web:deploy": "npx wrangler deploy --config wrangler.web.jsonc",
    "tauri": "tauri",
    "install:build": "pnpm run build",
    "install:local": "pnpm run install:build && node scripts/install-local.mjs",
    "cli:build": "pnpm run build",
    "cli:install": "pnpm run install:local",
    "tui": "pnpm run dev",
    "tui:build": "pnpm run build",
    "tui:install": "pnpm run install:local",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run test:tooling",
    "test:tooling": "node scripts/run-tooling-tests.mjs",
    "test:rust:cli": "cargo test --locked --manifest-path src-tauri/Cargo.toml --test cli_entrypoint --test onboarding_e2e",
    "test:rust:core": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib && cargo check --locked --manifest-path src-tauri/Cargo.toml --all-targets && node scripts/verify-core-no-gui-deps.mjs",
    "test:tauri": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features --features desktop --lib tauri_ipc_smoke -- --nocapture",
    "ui:dev": "pnpm run dev",
    "ui:typecheck": "bun run --cwd ui typecheck",
    "ui:test": "bun run --cwd ui test",
    "ui:workflow": "cargo build --locked --manifest-path src-tauri/Cargo.toml --no-default-features --bin norn-backend --bin norn && bun run ui/scripts/check-local-workflow.tsx",
    "ui:frames:check": "bun run --cwd ui frames:check",
    "ui:storybook": "bun run --cwd ui storybook",
    "ui:build-storybook": "bun run --cwd ui build-storybook",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs && git diff --exit-code -- src/protocol/generated/protocol.ts src/protocol/generated/protocol.schema.json",
    "evaluate": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --bin norn -- evaluate",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:deploy": "npx wrangler deploy --config wrangler.design-system.jsonc",
    "docs:dev": "pnpm --filter @norn/docs dev",
    "docs:build": "pnpm --filter @norn/docs build",
    "docs:preview": "pnpm --filter @norn/docs preview",
    "docs:deploy": "npx wrangler deploy --config wrangler.docs.jsonc",
    "build-storybook": "storybook build",
    "ui:bench": "bun run --cwd ui bench",
    "ui:repository-operations": "cargo build --locked --manifest-path src-tauri/Cargo.toml --no-default-features --bin norn-backend && bun run ui/scripts/check-repository-operations-ipc.ts",
    "core:build": "cargo build --locked --manifest-path src-tauri/Cargo.toml --release --bin norn --bin norn-backend --bin norn-tui --bin lachesi --bin lac",
    "ui:build": "bun run ui/scripts/build-executable.ts",
    "legacy:web:dev": "vite",
    "legacy:web:build": "tsc && vite build",
    "legacy:desktop:build": "pnpm run legacy:web:build && cargo build --locked --manifest-path src-tauri/Cargo.toml --release --no-default-features --features custom-protocol,desktop-bundle --bin norn-app",
    "legacy:tui": "cargo run --locked --manifest-path src-tauri/Cargo.toml --no-default-features --features tui --bin norn-tui",
    "legacy:web:preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.5.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gitdiff-parser": "^0.3.1",
    "react": "^19.1.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.8.1",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@storybook/addon-a11y": "10.3.3",
    "@storybook/addon-docs": "10.3.3",
    "@storybook/addon-links": "10.3.3",
    "@storybook/react-vite": "10.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "storybook": "10.3.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.5"
  }
}
