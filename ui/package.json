{
  "name": "@norn/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "frames:generate": "bun run scripts/render-frames.tsx",
    "frames:check": "bun run scripts/check-frames.ts",
    "storybook": "bun run frames:check && storybook dev -p 6007 --no-open",
    "build-storybook": "bun run frames:check && storybook build -o storybook-static",
    "bench": "bun run scripts/bench.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/react": "0.5.17",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@storybook/react-vite": "10.3.6",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.3.6",
    "typescript": "5.9.3",
    "vite": "7"
  }
}
